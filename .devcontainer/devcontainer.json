// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "CompCert devcontainer",
    "build":  {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "false"
        },
        "./features/ocaml": {
            "version": "${localEnv:OCAML_VERSION}",
            "packages": "fmt js_of_ocaml-compiler js_of_ocaml-ppx menhir ocamlformat#0.28.1 ppx_expect rocq-prover qcheck zarith",
            // Melange requires 'ocaml >= 4.14 & < 4.15', so it is installable on
            // the 4.14 images only; the same devcontainer.json builds 4.14.3
            // through 5.5.0.
            "optional-packages": "melange",
            "system-packages": "libgmp-dev pkg-config",
            "repositories": "rocq-released https://rocq-prover.org/opam/released"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ocamllabs.ocaml-platform"
            ]
        }
    },
    "remoteUser": "vscode",
    "postCreateCommand": {
	"submodules": "git submodule update --init --recursive --depth 1",
        // See .devcontainer/fix-opam-owner.sh: a blind `chown -R` here forces
        // a full data copy-up of the whole opam/Rocq install on every fresh
        // container (this host's overlay2 has metacopy disabled), even
        // though ownership is usually already correct from image build.
        "opam": "sudo .devcontainer/fix-opam-owner.sh $(id -u) $(id -g)"
    },
    "waitFor": "postCreateCommand"
}
