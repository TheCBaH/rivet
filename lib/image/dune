; Symbols, layout, the internal linker, and §9's plan_image/bind_image contract.
;
; Depends on asm_core for the lowered module it consumes and on foundation for
; everything else. It must never acquire a dependency on target_intf or on a
; target: the linker's job is the same whatever produced the fragments, and a
; linker that could name a target would be one that could special-case one.

(library
 (name image)
 (public_name rivet.image)
 (modes byte native)
 (libraries foundation asm_core rivet_fmt)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))
