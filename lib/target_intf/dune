; The TARGET signature, in two libraries because it describes two halves that
; are wanted apart.
;
; target_encode is everything below source text - normalize, lower, encode,
; decode, evaluate a fixup, pad - and reaches no front end. target_intf adds
; the three members that read source text, and so depends on asm_syntax. A
; consumer that builds instructions as values (test/snippets, and anything that
; generates them) names the first and links no lexer; the pipeline names the
; second.
;
; Signatures only, both of them: no implementation, so a target depends on a
; description it cannot influence.

; target_error is the one module here that is *not* a signature: it is the
; shared target error domain (docs/errors.md). It needs its own library
; rather than joining target_encode, because a library whose name matches one of
; its modules treats that module as the whole interface and hides the rest.

(library
 (name target_error)
 (public_name rivet.target_error)
 (modules target_error)
 (modes byte native)
 (libraries foundation)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

; target_features (modules target_component, target_config) holds the descriptors a family publishes for its separable
; instruction components (docs/contracts.md). Pure data, like target_error.

(library
 (name target_features)
 (public_name rivet.target_features)
 (modules target_component target_config)
 (wrapped false)
 (modes byte native)
 (libraries foundation rivet_fmt)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

(library
 (name target_encode)
 (public_name rivet.target_encode)
 (modules target_encode)
 (modes byte native)
 (libraries foundation codec asm_core target_error target_features)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

(library
 (name target_intf)
 (public_name rivet.target_intf)
 (modules target)
 (modes byte native)
 (libraries
  foundation
  codec
  asm_core
  asm_syntax
  image
  target_encode
  target_features)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))
