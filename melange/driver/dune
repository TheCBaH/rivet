  driver_direct
  text_pipeline
  rivet_image
  rivet_target_intf
  x86_32
  x86_64
  arm
  aarch64
  riscv32
  riscv64
  rivet_fmt)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))
