; Melange build of driver. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all.

(copy_files#
 (files ../../driver/*.ml))

(library
 (name driver)
 (modes byte native melange)
 (libraries
  foundation
  codec
  asm_core
  asm_syntax
  image
  target_intf
  x86_32
  x86_64
  arm
  aarch64
  riscv32
  riscv64
  fmt)
 (enabled_if
  (= %{env:ASM_MELANGE=false} true)))
