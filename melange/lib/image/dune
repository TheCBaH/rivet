; Melange build of lib/image. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all.

(copy_files#
 (files ../../../lib/image/*.ml))

(copy_files#
 (files ../../../lib/image/*.mli))

(library
 (name image)
 (modes byte native melange)
 (libraries rivet_foundation rivet_asm_core rivet_fmt)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))
