; Melange build of lib/target_intf. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all.

(copy_files#
 (files ../../../lib/target_intf/*.ml))

(copy_files#
 (files ../../../lib/target_intf/*.mli))

