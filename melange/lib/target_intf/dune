; Melange build of lib/target_intf. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all.

(copy_files#
 (files ../../../lib/target_intf/*.ml))

(copy_files#
 (files ../../../lib/target_intf/*.mli))

(library
 (name target_error)
 (modules target_error)
 (modes byte native melange)
 (libraries rivet_foundation)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

(library
 (name target_features)
 (modules target_component target_config)
 (wrapped false)
 (modes byte native melange)
 (libraries rivet_foundation rivet_fmt)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

(library
 (name target_encode)
 (modules target_encode)
 (modes byte native melange)
 (libraries
  rivet_foundation
  codec
  rivet_asm_core
  target_error
  target_features)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

(library
 (name target_intf)
 (modules target)
 (modes byte native melange)
 (libraries
  rivet_foundation
  codec
  rivet_asm_core
  rivet_asm_syntax
  image
  target_encode
  target_features)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))
