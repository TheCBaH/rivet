; Melange build of targets/aarch64. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all. Two libraries, for the
; reason targets/aarch64/dune gives: the encoder is linkable without a front end.

(copy_files#
 (files ../../../targets/aarch64/*.ml))

(copy_files#
 (files ../../../targets/aarch64/*.mli))

(library
 (name rivet_aarch64_encode)
 (modules rivet_aarch64_encode aarch64_types aarch64_ops)
 (modes byte native melange)
 (libraries
  rivet_foundation
  rivet_codec
  rivet_asm_core
  rivet_target_error
  rivet_target_encode)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

(library
 (name rivet_aarch64)
 (modules rivet_aarch64)
 (modes byte native melange)
 (libraries
  rivet_foundation
  rivet_codec
  rivet_asm_core
  rivet_asm_syntax
  rivet_target_intf
  rivet_aarch64_encode)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))
