; Melange build of targets/aarch64_asm. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all. Typed AArch64 builders.

(copy_files#
 (files ../../../targets/aarch64_asm/*.ml))

(copy_files#
 (files ../../../targets/aarch64_asm/*.mli))

(library
 (name rivet_aarch64_asm)
 (modules rivet_aarch64_asm)
 (modes byte native melange)
 (libraries rivet_foundation rivet_asm_core rivet_aarch64_encode)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))
