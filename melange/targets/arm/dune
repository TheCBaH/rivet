; Melange build of targets/arm. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all. Two libraries, for the
; reason targets/arm/dune gives: the encoder is linkable without a front end.

(copy_files#
 (files ../../../targets/arm/*.ml))

(copy_files#
 (files ../../../targets/arm/*.mli))

(library
 (name rivet_arm_encode)
 (modules rivet_arm_encode arm_types arm_ops)
 (modes byte native melange)
 (libraries
  rivet_foundation
  rivet_codec
  rivet_asm_core
  rivet_target_error
  rivet_target_encode)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

(library
 (name rivet_arm)
 (modules rivet_arm)
 (modes byte native melange)
 (libraries
  rivet_foundation
  rivet_codec
  rivet_asm_core
  rivet_asm_syntax
  rivet_target_intf
  rivet_arm_encode)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))
