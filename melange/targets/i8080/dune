; Melange build of targets/i8080. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all. Three libraries, as in
; targets/i8080/dune.

(copy_files#
 (files ../../../targets/i8080/*.ml))

(library
 (name i8080_encode)
 (modules i8080_encode i8080_ops)
 (modes byte native melange)
 (libraries
  foundation
  codec
  asm_core
  target_error
  target_encode
  target_features)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

