; Melange build of targets/riscv_asm. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all. Typed RISC-V builders: the hand-written opcodes (riscv_asm) and per XLEN the generated rows (riscv32_asm, riscv64_asm).

(copy_files#
 (files ../../../targets/riscv_asm/*.ml))

(copy_files#
 (files ../../../targets/riscv_asm/*.mli))

(library
 (name rivet_riscv_asm)
 (modules rivet_riscv_asm riscv_asm_rowkit)
 (modes byte native melange)
 (libraries rivet_foundation rivet_asm_core rivet_riscv_family_encode)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

(library
 (name rivet_riscv32_asm)
 (modules rivet_riscv32_asm riscv_asm_rows32)
 (private_modules riscv_asm_rows32)
 (modes byte native melange)
 (libraries
  rivet_foundation
  rivet_asm_core
  rivet_riscv_family_encode
  rivet_riscv_asm)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

(library
 (name rivet_riscv64_asm)
 (modules rivet_riscv64_asm riscv_asm_rows64)
 (private_modules riscv_asm_rows64)
 (modes byte native melange)
 (libraries
  rivet_foundation
  rivet_asm_core
  rivet_riscv_family_encode
  rivet_riscv_asm)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))
