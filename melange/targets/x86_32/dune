; Melange build of targets/x86_32. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all. Two libraries, for the
; reason targets/x86_32/dune gives: the mode lives with the encoder, and the
; front-end package carries it through the family's parser.

(copy_files#
 (files ../../../targets/x86_32/*.ml))

(library
 (name rivet_x86_32_encode)
 (modules rivet_x86_32_encode)
 (modes byte native melange)
 (libraries
  rivet_foundation
  rivet_codec
  rivet_asm_core
  rivet_target_error
  rivet_target_encode
  rivet_x86_family_encode)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

(library
 (name rivet_x86_32)
 (modules rivet_x86_32)
 (modes byte native melange)
 (libraries
  rivet_foundation
  rivet_codec
  rivet_asm_core
  rivet_target_intf
  rivet_x86_family
  rivet_x86_32_encode)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))
