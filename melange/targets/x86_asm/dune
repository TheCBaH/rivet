; Melange build of targets/x86_asm. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all. Typed x86 builders: what both modes share (x86_asm) and per mode (x86_32_asm, x86_64_asm).

(copy_files#
 (files ../../../targets/x86_asm/*.ml))

(copy_files#
 (files ../../../targets/x86_asm/*.mli))

(library
 (name rivet_x86_asm)
 (modules rivet_x86_asm)
 (modes byte native melange)
 (libraries
  rivet_foundation
  rivet_asm_core
  rivet_target_encode
  rivet_x86_family_encode)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

