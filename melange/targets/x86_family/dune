; Melange build of targets/x86_family. Same sources, copied rather than duplicated;
; see melange/dune for why the tree is mirrored at all. Two libraries, for the
; reason targets/x86_family/dune gives: the encoder is linkable without a front
; end.

(copy_files#
 (files ../../../targets/x86_family/*.ml))

(copy_files#
 (files ../../../targets/x86_family/*.mli))

(library
 (name x86_family_encode)
 (modules
  x86_family_encode
  x86_types
  x86_ops
  x86_x87
  x86_table_row
  x86_table_rows)
 (modes byte native melange)
 (libraries
  rivet_foundation
  rivet_codec
  rivet_asm_core
  rivet_target_error
  rivet_target_encode
  rivet_target_features)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

(library
 (name x86_family)
 (modules x86_family)
 (modes byte native melange)
 (libraries
  rivet_foundation
  rivet_codec
  rivet_asm_core
  rivet_asm_syntax
  rivet_target_intf
  x86_family_encode)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))
