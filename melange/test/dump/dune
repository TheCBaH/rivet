; Melange build of test/dump. Same sources, copied rather than duplicated; see
; melange/dune for why the tree is mirrored at all.
;
; Emitting from the very same driver source the native and js_of_ocaml builds
; run is the whole point: the three-build gate compares bytes, so a separate
; hand-written Melange entry point would weaken it into comparing two programs.

(copy_files#
 (files ../../../test/dump/*.ml))

(library
 (name test_dump_inputs)
 (modules test_dump_inputs)
 (modes byte native melange)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

; Mirrors test/dump/dune's smoke_fixtures library, same reason: a real
; library, not a module living beside manifest_dump.ml, so that
; melange/test/browser's smoke.ml emit can depend on it too.

(library
 (name smoke_fixtures)
 (modules smoke_fixtures)
 (modes byte native melange)
 (libraries rivet_driver rivet_asm_core rivet_fmt)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))

(melange.emit
 (target js)
 (modules asm_dump manifest_dump)
 (module_systems commonjs)
 (libraries
  rivet_foundation
  rivet_image
  rivet_target_intf
  rivet_driver
  test_dump_inputs
  rivet_asm_core
  rivet_fmt
  smoke_fixtures)
 (enabled_if
  (= %{env:RIVET_MELANGE=false} true)))
