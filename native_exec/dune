; Runs a laid-out image natively, in this process: maps it, binds it at the
; addresses obtained, and calls its entry. A research-host component, not
; part of the assembler: no production library may depend on it, and it is
; gated by RIVET_NATIVE_EXEC so that the default builds stay free of C.

(library
 (name native_exec)
 (public_name rivet.native_exec)
 (modes byte native)
 (libraries foundation asm_core image unix)
 (foreign_stubs
  (language c)
  (names native_exec_stubs))
 (enabled_if
  (= %{env:RIVET_NATIVE_EXEC=false} true)))
