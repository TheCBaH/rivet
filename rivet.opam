opam-version: "2.0"
synopsis: "Retargetable assembler and linker in pure OCaml"
description: """
Reads GNU-syntax assembly for x86-32, x86-64, ARM, AArch64, RV32 and RV64,
produces an in-memory image, and binds it at chosen addresses. Running an
image in the calling process is the separate package rivet-native-exec.

This package is built with RIVET_EXTERNAL_DEPS=true: it uses the installed
fmt and err_trace, so a program linking it has one Fmt and one Err. It is not
the standalone build (vendored Fmt, from a git submodule) nor the
Melange one; see the README.
"""
maintainer: "Vladimir N. Silyaev"
authors: ["Vladimir N. Silyaev"]
license: "MIT"
homepage: "https://github.com/TheCBaH/rivet"
bug-reports: "https://github.com/TheCBaH/rivet/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.15"}
  "menhir" {>= "20211128"}
  "fmt" {>= "0.9.0"}
  "err_trace" {>= "0.3.0"}
  "ppx_expect" {with-test}
]
build: [
  ["env" "RIVET_EXTERNAL_DEPS=true"
   "dune" "build" "-p" name "-j" jobs "@install"]
]
# err_trace is not in opam-repository yet; the devcontainer pins the same commit.
pin-depends: [
  ["err_trace.0.3.0" "git+https://github.com/TheCBaH/err_trace.git#8138a417b452e55483028df851cb562fbf175eed"]
]
