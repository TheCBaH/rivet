# The oracle release the i8080 legs run against (asl, p2bin, altairz80,
# the 8080PRE/8080EX1 sources and the vm80a_sim harness). Nothing is built
# here: scripts/retrocpu-fetch.sh downloads these assets by tag and refuses
# anything whose SHA-256 differs from the lines below (the release's SHA256SUMS).
RETROCPU_REPO=TheCBaH/devcontainer.retrocpu-tools
RETROCPU_TAG=v0.0.2

RETROCPU_SHA256_tools_x86_64=4edd3fc72c7bb883de6d5a82fc52078ce1423160a39f45931ef3b359eba46f89
