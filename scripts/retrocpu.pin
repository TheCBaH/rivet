RETROCPU_SHA256_diagnostics_x86_64=33b917d1cf8cecfd0e59c69eed540285074c523ac0631a2f4928bac67b3081a7
RETROCPU_SHA256_diagnostics_aarch64=5b7b99c73c29e706c3ff2cab5305872017579ccb1a8ac8fb2abaa32a58f1d48d
