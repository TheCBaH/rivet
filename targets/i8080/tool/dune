; The i8080 command line: assemble AS-dialect sources, run programs in the
; behavioural model. Held to the same closure as the target.

(library
 (name i8080_corpus)
 (modules i8080_corpus)
 (libraries rivet_i8080_asm)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

(executable
 (name i8080_tool)
 (modules i8080_tool i8080_gen)
 (modes native)
 (libraries
  rivet_compute
  rivet_i8080_asm
  i8080_corpus
  rivet_i8080_encode
  rivet_i8080_as
  rivet_i8080_ops
  rivet_i8080_sem
  rivet_i8080_text
  rivet_i8080_run
  rivet_foundation)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))
