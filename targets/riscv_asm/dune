; Typed instruction builders, from the per-target opcode tables: the hand-written opcodes'
; builders (riscv_asm), and per XLEN those with the generated rows' builders added.

(library
 (name rivet_riscv_asm)
 (public_name rivet.riscv_asm)
 (modules rivet_riscv_asm riscv_asm_rowkit)
 (modes byte native)
 (libraries rivet_foundation rivet_asm_core rivet_riscv_family_encode)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

(library
 (name rivet_riscv32_asm)
 (public_name rivet.riscv32_asm)
 (modules rivet_riscv32_asm riscv_asm_rows32)
 (modes byte native)
 (libraries
  rivet_foundation
  rivet_asm_core
  rivet_riscv_family_encode
  rivet_riscv_asm)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

(library
 (name rivet_riscv64_asm)
 (public_name rivet.riscv64_asm)
 (modules rivet_riscv64_asm riscv_asm_rows64)
 (modes byte native)
 (libraries
  rivet_foundation
  rivet_asm_core
  rivet_riscv_family_encode
  rivet_riscv_asm)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))
