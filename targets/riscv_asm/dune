; Typed instruction builders, from the per-target opcode tables: the hand-written opcodes'
; builders (riscv_asm), and per XLEN those with the generated rows' builders added.

(library
 (name riscv_asm)
 (public_name rivet.riscv_asm)
 (modules riscv_asm riscv_asm_rowkit)
 (modes byte native)
 (libraries foundation asm_core riscv_family_encode)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

(library
 (name riscv32_asm)
 (public_name rivet.riscv32_asm)
 (modules riscv32_asm riscv_asm_rows32)
 (modes byte native)
 (libraries foundation asm_core riscv_family_encode riscv_asm)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

(library
 (name riscv64_asm)
 (public_name rivet.riscv64_asm)
 (modules riscv64_asm riscv_asm_rows64)
 (modes byte native)
 (libraries foundation asm_core riscv_family_encode riscv_asm)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))
