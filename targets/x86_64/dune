; The x86_64 target, in two libraries for the family's reason: x86_64_encode
; carries the mode and the encoder (ENCODE, no lexer), x86_64 carries the same
; mode through the family's front end (TARGET). The mode is written once, in
; the encode package, and the front-end package names it there.

(library
 (name rivet_x86_64_encode)
 (public_name rivet.x86_64_encode)
 (modules rivet_x86_64_encode)
 (modes byte native)
 (libraries
  rivet_foundation
  rivet_codec
  rivet_asm_core
  rivet_target_error
  rivet_target_encode
  rivet_x86_family_encode)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

(library
 (name rivet_x86_64)
 (public_name rivet.x86_64)
 (modules rivet_x86_64)
 (modes byte native)
 (libraries
  rivet_foundation
  rivet_codec
  rivet_asm_core
  rivet_target_intf
  rivet_x86_family
  rivet_x86_64_encode)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))
