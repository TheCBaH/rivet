; Path coherence (M1.7). Uses the statically selected target module rather than
; the erased DRIVER, which is the point: the types in this file are Aarch64's
; own, so handing it an ARM normalized AST is a compile error.
;
; test_coherence is the fixtures alone, public for consumers that check their
; own producers against them; it takes no ppx, so installing it needs no test
; dependency. The expect tests over it stay private.

(library
 (name test_coherence)
 (public_name rivet.test_support)
 (modules test_coherence)
 (modes byte native)
 (libraries
  rivet_driver
  rivet_image
  rivet_asm_core
  aarch64
  rivet_foundation
  test_dump_inputs
  rivet_fmt)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

(library
 (name test_coherence_paths)
 (modules test_coherence_paths)
 (modes byte native)
 (libraries
  test_coherence
  rivet_asm_core
  rivet_foundation
  rivet_image
  rivet_fmt)
 (inline_tests)
 (preprocess
  (pps ppx_expect))
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))
