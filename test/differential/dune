; The M1.5 differential gate. Reads the committed fixtures and their GNU oracle
; artifacts as ordinary files, so this needs no cross toolchain and no emulator
; and runs in every leg of the portable matrix.
;
; differential is the gate itself, parameterised by the corpus and public (no
; ppx), so another project can run it over its own compiler's fixtures;
; test_differential instantiates it for fixtures/gcc-14 and pins the transcripts.

(library
 (name rivet_differential)
 (public_name rivet.differential)
 (modules rivet_differential)
 (modes byte native)
 (libraries
  rivet_driver
  rivet_image
  rivet_target_intf
  rivet_foundation
  rivet_fmt)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

(library
 (name test_differential)
 (modules test_differential)
 (modes byte native)
 (libraries rivet_differential rivet_test_dump_inputs)
 (inline_tests
  (deps
   (glob_files_rec %{workspace_root}/fixtures/gcc-14/**)))
 (preprocess
  (pps ppx_expect))
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))
