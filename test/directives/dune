; Directive semantics through the whole text pipeline, per target. Bytes quoted
; here were measured with the matching GNU as (binutils 2.44); test/xref's
; corpus compares .text only, so section-level directive behaviour lives here.

(library
 (name test_directives)
 (modules test_directives)
 (modes byte native)
 (libraries
  rivet_driver
  rivet_image
  rivet_target_intf
  rivet_foundation
  rivet_fmt)
 (inline_tests)
 (preprocess
  (pps ppx_expect))
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))
