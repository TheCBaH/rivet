; The seed for the three-build equality gate at the assembler level.
;
; Two stanzas. test_dump_inputs holds the six fixture texts as string literals
; and nothing else, so it can be shared with test/coherence without dragging in
; the driver; asm_dump is the executable, built for native and js_of_ocaml here
; and emitted by Melange under melange/test/dump from the same source.
;
; Neither is gated on RIVET_MELANGE: the melange/ mirror declares every library in
; byte and native modes as well, so these link in both configurations - which is
; what lets the cram stanza name the artifacts unconditionally.

(library
 (name test_dump_inputs)
 (public_name rivet.test_dump_inputs)
 (modules test_dump_inputs)
 (modes byte native)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

(executables
 (names asm_dump)
 (modules asm_dump)
 (modes exe js)
 (libraries foundation image target_intf driver test_dump_inputs rivet_fmt))

; The manifest three-build driver's shared fixture (docs/design.md M4 Phase
; 8, extended by M5's real-browser harness). A real library, not a module
; living beside manifest_dump.ml: an executable's modules cannot be linked by
; another executable, and test/browser/smoke.ml needs this exact source
; and rendering, not a copy of it. Same enabled_if as test_dump_inputs, same
; reason.

(library
 (name smoke_fixtures)
 (modules smoke_fixtures)
 (modes byte native)
 (libraries driver asm_core rivet_fmt)
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))

; The manifest three-build driver (docs/design.md M4 Phase 8). Its own
; stanza rather than a module of asm_dump: it reaches only [driver] and
; [asm_core] (for Perms.to_string), not [image]/[target_intf] directly, and a
; shared stanza would blur that.

(executables
 (names manifest_dump)
 (modules manifest_dump)
 (modes exe js)
 (libraries foundation driver asm_core err_trace rivet_fmt smoke_fixtures))
