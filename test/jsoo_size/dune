; What a browser worker that prints and disassembles pays for, per closure:
; scripts/jsoo-size.sh builds these with js_of_ocaml in the release profile
; and reports their sizes. Off unless RIVET_JSOO_SIZE=true.

(executable
 (name size_driver)
 (modules size_driver)
 (modes js)
 (libraries
  rivet_asm_core
  rivet_driver
  rivet_target_intf
  x86_64_encode
  rivet_aarch64_encode
  rivet_riscv32_encode)
 (enabled_if
  (= %{env:RIVET_JSOO_SIZE=false} true)))

(executable
 (name size_text)
 (modules size_text)
 (modes js)
 (libraries
  rivet_asm_core
  rivet_text_pipeline
  rivet_target_encode
  x86_64
  rivet_aarch64
  rivet_riscv32)
 (enabled_if
  (= %{env:RIVET_JSOO_SIZE=false} true)))

(executable
 (name size_direct)
 (modules size_direct)
 (modes js)
 (libraries
  rivet_asm_core
  rivet_driver_direct
  rivet_target_encode
  x86_64_encode
  rivet_aarch64_encode
  rivet_riscv32_encode)
 (enabled_if
  (= %{env:RIVET_JSOO_SIZE=false} true)))

(executable
 (name size_direct_no_x86)
 (modules size_direct_no_x86)
 (modes js)
 (libraries
  rivet_asm_core
