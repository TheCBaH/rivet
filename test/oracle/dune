; The host side of the execution ABI (asm/docs/exec-abi-v1.md).
;
; Two stanzas, split by what they need from the operating system.
;
; asm_oracle       the wire itself: constants, the manifest writer, the
;                  four-step recovery validator, and the frozen reference
;                  snippets of §16.3. Pure OCaml over strings, no
;                  Unix, so it builds and its tests run on every CI leg -
;                  including the 31-bit linux/i386 and linux/arm/v7 ones, which
;                  is why every address here is int64. Keeping it Unix-free is
;                  also what lets §16.4's synthetic record cases - the terminal
;                  fault schema no user-mode helper can publish, and records
;                  interrupted on both sides of a commit store - be ordinary
;                  unit tests instead of something only QEMU can produce.
;
; test_oracle      the synthetic conformance cases over asm_oracle. ppx_expect,
;                  hence native only and outside the production closure by
;                  construction; tools/asm-check-purity.sh classifies test/ as a
;                  non-production tree and rejects any production library that
;                  reaches it.
;
; Both carry the ASM_MELANGE gate the libraries use, because they depend on the
; vendored Fmt, whose non-Melange stanza is disabled in that configuration.
;
; asm_oracle_run  the QEMU process runner. Unix lives here and nowhere else on
;                 the host side; §3.7 bans it from every production and browser
;                 package and tools/asm-check-purity.sh enforces that over the
;                 resolved DAG. Native only, and deliberately not wired to any
;                 alias: it needs the cross-built helpers and the six qemu-user
;                 binaries, which the portable CI leg does not have.
;
; conform         the conformance driver (make asm-abi-conform). An executable,
;                 not a runtest rule, for the same reason - `make asm-test` must
;                 never acquire a hidden cross-toolchain or QEMU dependency.

; snippet_bytes no longer holds the §16.3 snippets - test/snippets assembles
; them and conform runs what it produces. What is left here is the record shape
; the suite consumes, the stack size and the M1.6 control pair, which is why
; this library still has no dependency of its own beyond fmt.

(library
 (name asm_oracle)
 (modules abi abi_v2 abi_v3 manifest record snippet_bytes)
 (modes byte native)
 (libraries fmt)
 (enabled_if
  (<> %{env:ASM_MELANGE=false} true)))

(library
 (name test_oracle)
 (modules test_record test_manifest)
 (modes byte native)
 (libraries asm_oracle fmt)
 (inline_tests)
 (preprocess
  (pps ppx_expect))
 (enabled_if
  (<> %{env:ASM_MELANGE=false} true)))

(library
 (name asm_oracle_run)
 (modules qemu_user)
 (modes byte native)
 (libraries asm_oracle fmt unix)
 (enabled_if
  (<> %{env:ASM_MELANGE=false} true)))

; conform takes the snippets from snippet_corpus, which is what M2 made
; possible and M1 could not afford. The edge is deliberately to the corpus and
; not to driver: the corpus builds instructions as ASTs and pushes them through
; lower/encode/plan/bind, so this executable links the assembler's *encoding*
; half and nothing above it. Checked rather than asserted - there is no
; asm_syntax module in the linked binary, so no lexer, no Menhir table and no
; token type reach the conformance suite. That is what the asm_core/asm_syntax
; and ENCODE/TARGET splits are for.

(executable
 (name conform)
 (modules conform)
 (modes exe)
 (libraries asm_oracle asm_oracle_run snippet_corpus fmt)
 (enabled_if
  (<> %{env:ASM_MELANGE=false} true)))

; Phase 3.4's direct v3 multi-value proof (abi_v3_smoke.ml's header comment).
; Not wired to any Make target - a one-off, hand-built manifest, exercised via
; ASM_HELPERS_DIR against a real generated helper while no fixture exists yet.
(executable
 (name abi_v3_smoke)
 (modules abi_v3_smoke)
 (modes exe)
 (libraries asm_oracle asm_oracle_run fmt)
 (enabled_if
  (<> %{env:ASM_MELANGE=false} true)))

; The ABI generator (.ai/asm_plan.md M4 Phase 3.2): a named, buildable,
; invocable executable - not a library module with no way to run it, which is
; what round 3's review specifically required. Pure text generation, no
; dependency on asm_oracle's wire constants (abi_gen.ml transcribes them
; directly as .equ text, the same way the frozen helpers/*.s files do) and no
; Unix, so it builds on every leg tools/asm-helpers.sh might run on.
(executable
 (name abi_gen_main)
 (modules abi_gen abi_gen_text abi_gen_main)
 (modes exe)
 (enabled_if
  (<> %{env:ASM_MELANGE=false} true)))

; exec is M1.6, the E5 rung: it assembles the fixtures with this project's own
; assembler and runs the result. It therefore reaches the whole production
; closure as well as the QEMU runner, which is why it is its own stanza and not
; another module of conform - the conformance driver deliberately depends on no
; part of the assembler, so that a broken assembler cannot make the ABI suite
; pass.

(executable
 (name exec)
 (modules exec)
 (modes exe)
 (libraries
  asm_oracle
  asm_oracle_run
  driver
  image
  target_intf
  foundation
  fmt)
 (enabled_if
  (<> %{env:ASM_MELANGE=false} true)))
