; The typed host trampolines of the AArch64 and x86-64 encoders against the
; assembly text Native_exec generates for the same names and addresses: the
; two must lay out the same bytes. Needs Native_exec, so it is gated with it.

(library
 (name trampolines)
 (modules trampolines)
 (modes byte native)
 (libraries
  rivet_native_exec
  rivet_driver
  rivet_driver_direct
  rivet_aarch64_encode
  rivet_x86_64_encode
  rivet_target_intf
  rivet_foundation
  rivet_asm_core
  rivet_image)
 (inline_tests)
 (preprocess
  (pps ppx_expect))
 (enabled_if
  (= %{env:RIVET_NATIVE_EXEC=false} true)))
