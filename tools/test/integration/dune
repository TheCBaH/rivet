; A CORPUS-ONLY integration test: it reads fixtures/**, which IS inside the
; dune workspace, so it can be a sandboxed runtest rule with declared deps.
;
; The repository-level tests, which read Makefile and scripts/target-matrix.sh
; from OUTSIDE the tools/ project's own tree, cannot be runtest rules and are
; run by Make instead.

(executable
 (name corpus_hashes)
 (modes byte native)
 (libraries rivet_tools err_trace bos fpath unix))

(rule
 (alias runtest)
 (deps
  corpus_hashes.exe
  (glob_files_rec %{workspace_root}/fixtures/c/**)
  (glob_files_rec %{workspace_root}/fixtures/gcc-14/**)
  (glob_files_rec %{workspace_root}/fixtures/gas-xref/**))
 (action
  (run ./corpus_hashes.exe %{workspace_root}/fixtures)))
