; An executable plus a rule rather than a (test) stanza, matching asm/test's
; convention: (test) puts its executable in the directory's @all alias whatever
; its enabled_if says.

(executables
 (names
  test_command
  test_fs
  test_process
  test_manifest
  test_gnu_output
  test_supervisor
  test_tool_gate
  test_isa_inventory_riscv
  test_isa_inventory_xed
  test_isa_norm_riscv
  test_isa_norm_xed
  test_isa_norm_jsonl
  test_isa_source_snapshot_diff
  test_isa_generated_case
  test_isa_gen_pilot
  test_isa_gen_render
  test_isa_gen_case_build
  test_isa_gen_oracle
  test_isa_generated_corpus
  test_isa_gen_ours
  test_isa_gen_verdict
  test_isa_gen_difficult)
 (modes byte native)
 (libraries compcert_tools err_trace bos fpath unix))

(rule
 (alias runtest)
 (action
  (run ./test_command.exe)))

(rule
 (alias runtest)
 (action
  (run ./test_fs.exe)))

; The fake tool is a declared dependency, not something the test hopes to find:
; without this the suite would pass vacuously in a sandbox where it was absent.

(rule
 (alias runtest)
 (deps ../fake/fake_tool.exe)
 (action
  (run ./test_process.exe)))

; test_manifest reads the real committed manifests, which ARE inside the dune
; workspace, so they are declared deps and the corpus path is passed as argv.

(rule
 (alias runtest)
 (deps
  (glob_files_rec %{workspace_root}/fixtures/compcert-3.17/**)
  (glob_files_rec %{workspace_root}/fixtures/gas-xref/**))
 (action
  (run ./test_manifest.exe %{workspace_root}/fixtures)))

; The Phase 4 parsers, compared against the committed oracle artifacts. Two
; declared dependency sets: the recorded binutils output in this project, and
; the corpus those artifacts live in. Neither is discovered at run time.

(rule
 (alias runtest)
 (deps
  (glob_files_rec %{workspace_root}/fixtures/compcert-3.17/**)
  (glob_files_rec ../data/gnu/*))
 (action
  (run ./test_gnu_output.exe ../data/gnu %{workspace_root}/fixtures)))

; Supervised background processes. No declared deps: it spawns only /bin/sh,
; sleep, false and scripts it writes into its own scratch directory.

(rule
 (alias runtest)
 (action
  (run ./test_supervisor.exe)))

; The tool gate's pure parts: the snippet discrimination property and the four
; sed/awk/tr transcriptions. No deps - it runs no external tool at all.

(rule
 (alias runtest)
 (action
  (run ./test_tool_gate.exe)))

; Isa_inventory_riscv's pure parts: parse_extension_file, applies_to and the
; renderers, all against inline text - no submodule dependency, see the file's
; own header comment.

(rule
 (alias runtest)
 (action
  (run ./test_isa_inventory_riscv.exe)))

; Isa_inventory_xed's pure parts: parse_datafile against both XED dialects
; and the not64/mode64 aggregation, all against inline text - no submodule
; dependency, see the file's own header comment.

(rule
 (alias runtest)
 (action
  (run ./test_isa_inventory_xed.exe)))

; Isa_norm_riscv against the five frozen NORM-01 pilot records
; (§7), embedded as inline JSONL text taken
; verbatim from the checked-in isa-db export - no filesystem dependency,
; same convention as the two isa-inventory suites above.

(rule
 (alias runtest)
 (action
  (run ./test_isa_norm_riscv.exe)))

; Isa_norm_xed against the two frozen NORM-01 pilot records, same convention.

(rule
 (alias runtest)
 (action
  (run ./test_isa_norm_xed.exe)))

; Isa_norm_jsonl's codec against synthetic forms covering every
; Isa_norm_model constructor, plus determinism and schema_version-mismatch
; checks - a codec concern, independent of any one source's normalization.

(rule
 (alias runtest)
 (action
  (run ./test_isa_norm_jsonl.exe)))

; Isa_source_snapshot_diff's pure diff plus load/diff_files against real
; temporary files it writes and removes itself - no checked-in fixture
; dependency, since the point is the mapping mechanism, not any one file.

(rule
 (alias runtest)
 (action
  (run ./test_isa_source_snapshot_diff.exe)))

; Isa_generated_case's frozen schema/tier names (GAS-01) - a design freeze,
; not generation logic: pins the exact frozen strings and proves the case/
; artifact/verdict shapes compose for a representative of every verdict row.

(rule
 (alias runtest)
 (action
  (run ./test_isa_generated_case.exe)))

; Isa_gen_pilot's own shape (GEN-01): counts, addw's single-target XLEN
; restriction, and obligations naming real pilot form_ids. Grounding every
; entry against real normalization output is repo_tests.ml's job instead.

(rule
 (alias runtest)
 (action
  (run ./test_isa_gen_pilot.exe)))

; Isa_gen_render/Isa_gen_case_build/Isa_gen_oracle's pure parts (GAS-02):
; syntax substitution, the canonical operand table, and the observed-form
; check logic. No toolchain dependency - the real assembler invocation is
; make asm-isa-generated-regen's job, never tools-test/tools-integration's.

(rule
 (alias runtest)
 (action
  (run ./test_isa_gen_render.exe)))

(rule
 (alias runtest)
 (action
  (run ./test_isa_gen_case_build.exe)))

(rule
 (alias runtest)
 (action
  (run ./test_isa_gen_oracle.exe)))

(rule
 (alias runtest)
 (action
  (run ./test_isa_generated_corpus.exe)))

; Isa_gen_ours.normalized_argv: pure, no toolchain and no dune-exec subprocess
; - the real tool/asm.exe invocation is make asm-isa-generated-regen's job,
; never tools-test/tools-integration's (work package GAS, task GAS-04).

(rule
 (alias runtest)
 (action
  (run ./test_isa_gen_ours.exe)))

; Isa_gen_verdict.classify/known_syntax_gap: pure, against the real bytes and
; diagnostics GAS-04's milestone measured for all 21 pilot cases.

(rule
 (alias runtest)
 (action
  (run ./test_isa_gen_verdict.exe)))

; Isa_gen_difficult: pure manifest/case-building checks (entry shapes, legal
; offset/label domains, render_source_lines wiring) - the real GNU/ours
; invocation is make asm-isa-difficult-regen's job (work package GEN, task
; GEN-03), never tools-test/tools-integration's.

(rule
 (alias runtest)
 (action
  (run ./test_isa_gen_difficult.exe)))
