; Opt-in RIVET_EXTERNAL_DEPS=true: Fmt comes from the consumer (opam, or a
; workspace package with that public name) instead of the vendored copy, so one
; executable links a single Fmt. The library below keeps the vendored library's
; name and public name, so nothing that depends on rivet changes; it only
; re-exports the host library. Native only: Melange keeps the vendored copy.

(library
 (name rivet_fmt)
 (public_name rivet.fmt)
 (modules)
 (libraries
  (re_export fmt))
 (enabled_if
  (and
   (<> %{env:RIVET_MELANGE=false} true)
   (= %{env:RIVET_EXTERNAL_DEPS=false} true))))
